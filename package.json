{
  "name": "chatgpt-skill-hub",
  "version": "0.1.0",
  "description": "MCP registry and gateway for discovering and reading reusable agent skills from ChatGPT and other MCP hosts.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts --stdio",
    "start": "tsx src/index.ts --stdio",
    "start:stdio": "tsx src/index.ts --stdio",
    "start:http": "tsx src/index.ts --http",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "build": "tsc",
    "start:dist": "node dist/src/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
